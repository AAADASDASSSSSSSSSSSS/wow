# RatsNest configuration -- copy to .env and uncomment ONE provider block.
# Real environment variables always override these values.
# The LLM is the brain of every agent; without it agents fall back to
# their deterministic paths (RATSNEST_LLM=auto) or refuse (=require).

# -- brain mode: off | auto | require ---------------------------------
RATSNEST_LLM=auto

# -- Anthropic (default provider) -------------------------------------
#RATSNEST_LLM_PROVIDER=anthropic
#RATSNEST_LLM_API_KEY=sk-ant-...
#RATSNEST_LLM_MODEL=claude-sonnet-5

# -- OpenAI ------------------------------------------------------------
#RATSNEST_LLM_PROVIDER=openai
#RATSNEST_LLM_API_KEY=sk-...
#RATSNEST_LLM_MODEL=gpt-4o-mini

# -- DeepSeek ----------------------------------------------------------
#RATSNEST_LLM_PROVIDER=deepseek
#RATSNEST_LLM_API_KEY=sk-...
#RATSNEST_LLM_MODEL=deepseek-chat

# -- Qwen / DashScope ---------------------------------------------------
#RATSNEST_LLM_PROVIDER=qwen
#RATSNEST_LLM_API_KEY=sk-...
#RATSNEST_LLM_MODEL=qwen-plus

# -- Moonshot / Kimi ----------------------------------------------------
#RATSNEST_LLM_PROVIDER=moonshot
#RATSNEST_LLM_API_KEY=sk-...
#RATSNEST_LLM_MODEL=moonshot-v1-8k

# -- Zhipu / GLM --------------------------------------------------------
#RATSNEST_LLM_PROVIDER=zhipu
#RATSNEST_LLM_API_KEY=...
#RATSNEST_LLM_MODEL=glm-4-plus

# -- Ollama (local, no key) --------------------------------------------
#RATSNEST_LLM_PROVIDER=ollama
#RATSNEST_LLM_MODEL=llama3.1
#RATSNEST_LLM_BASE_URL=http://localhost:11434

# -- optional overrides -------------------------------------------------
#RATSNEST_LLM_BASE_URL=          # custom endpoint (any provider)
#RATSNEST_LLM_TIMEOUT_SECONDS=60
#RATSNEST_LLM_RETRIES=2
#RATSNEST_LLM_MAX_CALLS=32
#RATSNEST_LLM_MAX_TOKENS_PER_CALL=3000
#RATSNEST_LLM_MAX_TOTAL_TOKENS=40000
#RATSNEST_LLM_MODEL_ROUTES={"circuit_architect":"deepseek-reasoner","schematic_designer":"deepseek-chat"}
#RATSNEST_KICAD_CLI=/path/to/kicad-cli

# -- production EDA verification ---------------------------------------
# Crew production runs require Freerouting plus KiCad ERC/DRC and ngspice.
#RATSNEST_ROUTING_MODE=freerouting
#RATSNEST_FREEROUTING_JAR=/path/to/freerouting.jar
#RATSNEST_FREEROUTING_JAVA=/path/to/java
#RATSNEST_FREEROUTING_MAX_PASSES=5
#RATSNEST_FREEROUTING_TIMEOUT_SECONDS=120
#RATSNEST_NGSPICE_LIBRARY=/path/to/ngspice/shared/library

# -- control plane / enterprise alpha ---------------------------------
#RATSNEST_SECURITY_MODE=jwt
#RATSNEST_JWT_SECRET=replace-with-at-least-32-random-bytes
#RATSNEST_SERVICE_TOKEN=replace-with-a-separate-random-service-token
#RATSNEST_COOKIE_SECURE=true       # production HTTPS only
#RATSNEST_ARTIFACT_ROOT=./data/artifacts
#RATSNEST_ARTIFACT_MAX_BYTES=268435456
